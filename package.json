{
  "name": "kiguflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --env-file .env",
    "dev:astro": "astro dev",
    "build": "astro check && astro build",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:worker-security": "tsx scripts/test-worker-security.ts",
    "backup:encrypted": "tsx scripts/backup-operational-data.ts",
    "backup:restore": "tsx scripts/restore-encrypted-backup.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/react": "7.0.1",
    "@aws-sdk/client-kms": "3.1147.0",
    "@aws-sdk/client-s3": "3.1147.0",
    "@fontsource-variable/geist": "latest",
    "@gsap/react": "latest",
    "@hono/zod-validator": "latest",
    "@neondatabase/serverless": "latest",
    "@phosphor-icons/react": "latest",
    "@tailwindcss/vite": "latest",
    "astro": "7.3.6",
    "dotenv": "latest",
    "drizzle-orm": "latest",
    "gsap": "latest",
    "hono": "latest",
    "nanoid": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sonner": "latest",
    "tailwindcss": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@cloudflare/workers-types": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "miniflare": {
      "undici": "7.29.1",
      "sharp": "0.35.5"
    },
    "@cloudflare/vite-plugin": {
      "wrangler": "4.148.0"
    }
  }
}
