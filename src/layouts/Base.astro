---
import '@/styles/global.css';
interface Props { title: string; description?: string; }
const { title, description = 'Freelance client work, clearly organized.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#010a04" />
    <script is:inline>
      (() => {
        const key = "kiguflow-theme";
        const query = matchMedia("(prefers-color-scheme: dark)");
        const readSaved = () => {
          try {
            const value = localStorage.getItem(key);
            return value === "light" || value === "dark" ? value : null;
          } catch {
            return null;
          }
        };
        const apply = (theme) => {
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", theme === "dark" ? "#010a04" : "#f4f2e9");
          dispatchEvent(new CustomEvent("kiguflow:theme-change", { detail: theme }));
        };
        apply(readSaved() || (query.matches ? "dark" : "light"));
        query.addEventListener("change", (event) => {
          if (!readSaved()) apply(event.matches ? "dark" : "light");
        });
      })();
    </script>
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
